#!/usr/bin/env bash
# Print the repo's default branch (main or master).
set -euo pipefail

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "not a git repository" >&2
  exit 1
fi

if remote_head=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null); then
  echo "${remote_head#refs/remotes/origin/}"
  exit 0
fi

if git remote get-url origin >/dev/null 2>&1; then
  if git remote set-head origin -a >/dev/null 2>&1; then
    if remote_head=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null); then
      echo "${remote_head#refs/remotes/origin/}"
      exit 0
    fi
  fi
fi

for b in main master; do
  if git show-ref --verify --quiet "refs/remotes/origin/$b"; then
    echo "$b"
    exit 0
  fi
done

for b in main master; do
  if git show-ref --verify --quiet "refs/heads/$b"; then
    echo "$b"
    exit 0
  fi
done

echo "could not determine default branch" >&2
exit 1
