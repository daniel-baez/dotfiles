# Included via: git config --global include.path ~/.config/dotfiles.gitconfig
# Cheatsheet: `g aliases`   Guide: README.md
#
# Convention: type `g <command>` (g = git). Workflows live as git-* bins on PATH.

[alias]
	# inspect
	s = status -sb
	d = diff
	ds = diff --staged
	l = log --oneline --decorate --graph -20
	ll = log -1 --stat
	b = branch

	# change
	a = add -A
	ap = add -p
	c = commit
	amend = commit --amend --no-edit
	unstage = restore --staged
	undo = reset --keep HEAD~1
	wip = !git add -A && git commit -m "wip"

	# move
	sw = switch
	new = switch -c
	develop = !git switch develop && git pull

	# share
	f = fetch
	pf = push --force-with-lease

[init]
	defaultBranch = main

[pull]
	rebase = false

[core]
	excludesfile = ~/.gitignore_global

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[branch]
	sort = -committerdate

[rerere]
	enabled = true
